# The site's own origin
NEXT_PUBLIC_BASE_URL=http://localhost:3010

# Zentra runtime: server-only, never NEXT_PUBLIC_
OPENAI_API_KEY=
# MySQL server and database, created on first use. Required in production (use a dedicated user).
# Local default: mysql://root@127.0.0.1:3306/zentra (XAMPP)
ZENTRA_DATABASE_URL=
# Server for the tests' throwaway databases (default mysql://root@127.0.0.1:3306)
ZENTRA_TEST_DATABASE_URL=
# Exact public origin behind a reverse proxy
ZENTRA_APP_ORIGIN=
# Required for production registration; optional in development
ZENTRA_SIGNUP_TOKEN=
# 64 hex characters (32 random bytes), required in every environment to store API keys.
# Keep it stable and back it up with the database; losing it makes stored keys unreadable.
ZENTRA_ENCRYPTION_KEY=
# Email sign-in codes by SMTP (any provider: Gmail app password, Resend, Brevo). Required in
# production; in development, leave the host empty and codes are printed in the server console.
# Also needs ZENTRA_ENCRYPTION_KEY, which keys the stored code digests. hupsocial's SMTP_* names work too.
ZENTRA_SMTP_HOST=
ZENTRA_SMTP_PORT=465
ZENTRA_SMTP_USER=
ZENTRA_SMTP_PASS=
ZENTRA_SMTP_FROM="Zentra <no-reply@example.com>"
# Wallet sign-in: WalletConnect (mobile wallets by QR code) appears once this free Reown project
# id is set. Browser wallets and the LUKSO extension work without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Realtime process (server/realtime.js): its port, and in production nginx serves it at /ws.
# NEXT_PUBLIC_REALTIME_URL overrides the socket address the browser uses.
ZENTRA_REALTIME_PORT=3011
NEXT_PUBLIC_REALTIME_URL=
# Chat moderators: public names, comma separated
ZENTRA_MODERATORS=
